{
  "name": "nodevault",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test": "bun test",
    "test:py": "python3 -m unittest discover -s addon/tests -t . -v && python3 -m unittest discover -s scripts/tests -t . -v",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}