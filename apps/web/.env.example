# Local development uses the Postgres container from `bun run db:up`.
# Leave unset and tests keep using .data/. Production sets this on Vercel.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5435/nodevault

# Vercel Blob. Unset = files on disk under NODEVAULT_DATA_DIR or .data/
# BLOB_READ_WRITE_TOKEN=

# Azure Blob for direct uploads (covers now, videos and .blend files use the same path).
# All three are required. The container is created if missing, with public blob reads and browser PUT (CORS).
# The storage account must allow public blob access. Pages link to the blob URL.
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=
# Optional Front Door (or other CDN) origin. When set, public URLs use this base instead of blob.core.windows.net.
# AZURE_CDN_BASE_URL=https://example.azurefd.net

# Required on Vercel. Anyone who can publish must send this as x-publish-token.
# Leave unset for local `bun test` / `next dev` so fixtures stay easy.
# PUBLISH_SECRET=

# Optional override for local disk catalog (tests set this automatically).
# NODEVAULT_DATA_DIR=

# How long the public post list stays cached, in seconds. Writes still clear it immediately.
# Default is 1800 (30 minutes).
# NODEVAULT_POSTS_CACHE_TTL_SECONDS=1800

# Public site origin when this is not running on Vercel.
# NEXT_PUBLIC_BASE_URL=http://localhost:5173

# Better Auth. Email and password needs only the secret. Google, X, and Discord need their keys.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Callbacks: /api/auth/callback/google, /api/auth/callback/twitter, /api/auth/callback/discord

# PostHog page analytics. Unset means the site sends nothing.
# Events go to /api/v1 on this site, which is rewritten to PostHog.
# NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Set only to bypass the proxy, for example https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=
