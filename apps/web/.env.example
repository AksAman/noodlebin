# Local development uses the Postgres container from `bun run db:up`.
# Leave unset and tests keep using .data/. Production sets this on Vercel.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5435/nodevault

# Vercel Blob. Unset = files on disk under NODEVAULT_DATA_DIR or .data/
# BLOB_READ_WRITE_TOKEN=

# Required on Vercel. Anyone who can publish must send this as x-publish-token.
# Leave unset for local `bun test` / `next dev` so fixtures stay easy.
# PUBLISH_SECRET=

# Optional override for local disk catalog (tests set this automatically).
# NODEVAULT_DATA_DIR=

# Public site origin when this is not running on Vercel.
# NEXT_PUBLIC_BASE_URL=http://localhost:5173

# Better Auth. Email and password needs only the secret. Google, X, and Discord need their keys.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Callbacks: /api/auth/callback/google, /api/auth/callback/twitter, /api/auth/callback/discord
